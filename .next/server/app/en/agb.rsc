5:["$","$L35",null,{"formats":"$undefined","locale":"en","messages":{"nav":{"home":"Home","events":"Events","about":"About","gallery":"Gallery","contact":"Contact","tickets":"Tickets"},"footer":{"tagline":"Good Vibe Raves — electronic music, the best energy, good people.","navigation":"Navigation","contact":"Contact","copyright":"© {year} VAYVE. All rights reserved.","imprint":"Imprint","privacy":"Privacy"},"home":{"hero":{"eyebrow":"Good Vibe Raves","line1":"Good music.","line2":"Good people.","line3":"Good vibes.","subtitle":"VAYVE brings the electronic scene together — at open airs, raves and everywhere in between.","ctaEvents":"Upcoming events","ctaTickets":"Tickets","scroll":"Scroll"},"upcoming":{"eyebrow":"Up next","title":"Upcoming events","viewAll":"All events","empty":"More coming soon — follow us on Instagram."},"vibe":{"eyebrow":"The vibe","title":"More than a rave","body":"VAYVE is about that feeling when the beat drops and everyone moves together. We create spaces for electronic music where everyone feels welcome and can just let go.","cta":"Get to know us"},"instagram":{"title":"Follow the vibe","body":"All updates, line-ups and good vibes first on Instagram.","cta":"@vayve.germany"}},"tickets":{"hero":{"eyebrow":"Tickets","title":"Grab your ticket","subtitle":"Tickets for our events — right here in the shop."},"fallback":"Shop not loading? Open in a new tab"},"events":{"hero":{"eyebrow":"Events","title":"All events","subtitle":"Open airs, raves and specials by VAYVE."},"upcomingTitle":"Upcoming","pastTitle":"Past","empty":"No events planned right now. Check back soon."},"eventDetail":{"back":"All events","when":"When","doors":"Doors","where":"Where","lineup":"Line-up","genres":"Sound","price":"Entry","past":"This event has passed.","moreEvents":"More events"},"about":{"hero":{"eyebrow":"About","title":"We are VAYVE","subtitle":"A crew that lives for electronic music and good vibes."},"story":{"title":"Why we do this","body1":"VAYVE was born out of love for the electronic scene. We wanted events where the music is front and centre and the energy carries from the first to the last minute.","body2":"Open air, rave or a run through the city with a DJ up front — it's always about the same thing: come together, dance and enjoy the moment."},"values":{"music":{"title":"The music","body":"Hard House, Trance, Bounce, House — we bring the sounds and acts that set the floor on fire."},"people":{"title":"The people","body":"Open, respectful, all in. At VAYVE everyone who brings good energy is welcome."},"vibes":{"title":"The vibes","body":"We take care of sound, light and everything around it so you can just let go."}},"cta":{"title":"Be there next time","body":"See what's coming up next.","button":"Upcoming events"}},"gallery":{"hero":{"eyebrow":"Gallery","title":"Impressions","subtitle":"Moments from our events."},"empty":"First impressions coming soon.","followCta":"More on Instagram"},"contact":{"hero":{"eyebrow":"Contact","title":"Say hi","subtitle":"Booking, collab or just hi — drop us a line."},"form":{"name":"Name","email":"Email","subject":"Subject","message":"Message","send":"Send","sending":"Sending…","successTitle":"Thanks!","successBody":"Your message reached us. We'll get back to you.","error":"Something went wrong. Please try again."},"info":{"title":"Direct","emailLabel":"Email","instagramLabel":"Instagram"}},"notFound":{"title":"Page not found","body":"This page doesn't exist (anymore).","back":"Back home"}},"now":"$undefined","timeZone":"UTC","children":[["$","$L36",null,{}],["$","$L37",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]}],["$","$L38",null,{}]]}]
