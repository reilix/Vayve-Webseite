{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/tickets/layout,_N_T_/[locale]/tickets/page,_N_T_/en/tickets"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/tickets/__PAGE__",
    "/$d$locale/tickets",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}