{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/ueber-uns/layout,_N_T_/[locale]/ueber-uns/page,_N_T_/en/ueber-uns"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/ueber-uns/__PAGE__",
    "/$d$locale/ueber-uns",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}