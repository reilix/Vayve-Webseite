 Events."},"empty":"Bald gibt's hier die ersten Eindrücke.","followCta":"Mehr auf Instagram"},"contact":{"hero":{"eyebrow":"Kontakt","title":"Sag Hallo","subtitle":"Booking, Kooperation oder einfach Hallo — schreib uns."},"form":{"name":"Name","email":"E-Mail","subject":"Betreff","message":"Nachricht","send":"Absenden","sending":"Wird gesendet…","successTitle":"Danke!","successBody":"Deine Nachricht ist bei uns. Wir melden uns.","error":"Etwas ist schiefgelaufen. Versuch's nochmal."},"info":{"title":"Direkt","emailLabel":"E-Mail","instagramLabel":"Instagram"}},"notFound":{"title":"Seite nicht gefunden","body":"Diese Seite gibt es nicht (mehr).","back":"Zur Startseite"}},"timeZone":"UTC","children":["$L3","$L4","$L5","$L6"]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"1cfb44y-LCH8gf_ExyAnx"}
